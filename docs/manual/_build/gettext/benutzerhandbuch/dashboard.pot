msgstr ""

#: ../../benutzerhandbuch/dashboard.rst:52
msgid "Aktivste Sänger in Setlists"
msgstr ""

#: ../../benutzerhandbuch/dashboard.rst:55
msgid "Kalender-Export (iCal)"
msgstr ""

#: ../../benutzerhandbuch/dashboard.rst:57
msgid "Unter **Mein Kalender** findet jeder Benutzer seine persönliche iCal-URL. Diese URL kann in gängige Kalender-Apps (Google Calendar, Apple Kalender, Thunderbird) eingebunden werden und zeigt alle Gigs und Proben automatisch an."
msgstr ""

#: ../../benutzerhandbuch/dashboard.rst:65
msgid "Die URL enthält einen persönlichen Token und sollte nicht öffentlich geteilt werden. Bei Bedarf kann der Token über das Profil zurückgesetzt werden."
msgstr ""
