{
    "version": 1,
    "disable_existing_loggers": false,
    "loggers": {
        "root": {
            "level": "DEBUG",
            "handlers": [
                "default"
            ],
            "propagate": false
        },
        "uvicorn.error": {
            "level": "INFO",
            "handlers": [
                "default",
                "file_handler"
            ],
            "propagate": false,
            "qualname": "uvicorn.error"
        },
        "uvicorn.access": {
            "level": "INFO",
            "handlers": [
                "access"
            ],
            "propagate": false,
            "qualname": "uvicorn.access"
        },
        "gunicorn.error": {
            "level": "INFO",
            "handlers": [
                "default",
                "file_handler"
            ],
            "propagate": false,
            "qualname": "gunicorn.error"
        },
        "gunicorn.access": {
            "level": "INFO",
            "handlers": [
                "access"
            ],
            "propagate": false,
            "qualname": "gunicorn.access"
        },
        "granian": {
            "level": "INFO",
            "handlers": [
                "default",
                "file_handler"
            ],
            "propagate": false,
            "qualname": "_granian"
        },
        "granian.access": {
            "level": "INFO",
            "handlers": [
                "access"
            ],
            "propagate": false,
            "qualname": "granian.access"
        }
    },

    "handlers": {
        "default": {
            "class": "logging.StreamHandler",
            "formatter": "default",
            "stream": "ext://sys.stdout"
        },
        "access": {
            "class": "logging.StreamHandler",
            "formatter": "access",
            "stream": "ext://sys.stdout"
        },
        "file_handler": {
            "class": "logging.handlers.WatchedFileHandler",
            "formatter": "default",
            "filename": "./backend/log/app.log"
        }
    },
    "formatters": {
        "default": {
            "format": "[%(asctime)s][%(filename)s:%(lineno)d][%(levelname)s][%(process)d][%(threadName)s] - %(message)s"
        },
        "access": {
            "format": "[%(asctime)s][%(filename)s:%(lineno)d][%(levelname)s][%(process)d][%(threadName)s] - %(message)s"
        }
    }
}
